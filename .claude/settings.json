{
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run test:*)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npm run verify)",
      "Bash(node --test *)"
    ],
    "ask": [
      "Edit(/docs/milestones/**)",
      "Write(/docs/milestones/**)",
      "Bash(git push *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/block-dev-server.mjs\""
          }
        ]
      }
    ]
  }
}

{
  "name": "twilight-timer",
  "version": "0.0.0",
  "private": true,
  "description": "Twilight Timer – Zug- und Phasen-Timer für Twilight Imperium 4 (PWA für das iPad)",
  "type": "module",
  "packageManager": "npm@11.20.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26.13.0 <27",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11.0.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test:repo": "node --test \"tests/repo/*.test.mjs\"",
    "verify": "turbo run lint typecheck test build && npm run test:repo",
    "dev": "turbo run dev",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
